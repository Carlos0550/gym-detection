# ===== Aplicación =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost

# ===== Base de datos =====
# Para Docker compose, el host es el nombre del servicio "postgres"
DATABASE_URL=postgresql+asyncpg://gym:gym@postgres:5432/gym
DATABASE_URL_SYNC=postgresql://gym:gym@postgres:5432/gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_DB=gym

# ===== JWT =====
# Generar uno seguro con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# ===== Motor facial (InsightFace) =====
FACE_MODEL_NAME=buffalo_l
FACE_EXECUTION_PROVIDER=CPUExecutionProvider
FACE_DET_SIZE_WIDTH=640
FACE_DET_SIZE_HEIGHT=640
# Threshold de cosine similarity (0–1) para considerar match positivo
FACE_THRESHOLD_MATCH=0.55
# Threshold inferior; entre LOW y MATCH => low_confidence
FACE_THRESHOLD_LOW=0.40
# Threshold para anti-duplicado en enrolamiento (más estricto)
FACE_THRESHOLD_DUPLICATE=0.60
# Tamaño mínimo del rostro detectado en píxeles
FACE_MIN_FACE_SIZE=100
# Score mínimo del detector (det_score)
FACE_MIN_DET_SCORE=0.65

# Ejecutar alembic upgrade head al iniciar (útil en Docker prod)
AUTO_MIGRATE=false

# ===== Seed inicial =====
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=changeme-123
SEED_SUPERADMIN_NAME=Admin Sistema
SEED_GYM_NAME=Gimnasio Demo
SEED_GYM_ADDRESS=Calle Falsa 123
SEED_GYM_PHONE=+5491100000000
